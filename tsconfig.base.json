{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "paths": {
      "@flow-desk/core": ["./libs/core/src/index.ts"],
      "@flow-desk/data-access": ["./libs/data-access/src/index.ts"],
      "@flow-desk/styles": ["./libs/styles/src/index.ts"],
      "@flow-desk/styles/mixins": ["./libs/styles/src/lib/mixins.scss"],
      "@flow-desk/feature": ["./libs/feature/src/index.ts"],
      "@flow-desk/core-ui": ["./libs/core-ui/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
